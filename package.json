{
  "name": "amparian-api",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "lodash": "^4.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "pretest": "npm run typecheck:tests",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js",
    "seed:demo": "tsx src/scripts/seed-demo-data.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@azure/storage-blob": "^12.33.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.2.9",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "mysql2": "^3.22.2",
    "nodemailer": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}

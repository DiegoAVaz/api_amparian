PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://amparian-front.vercel.app
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_LOGIN_MAX=15
AUTH_RATE_LIMIT_REGISTER_MAX=15
AUTH_RATE_LIMIT_REFRESH_MAX=15
AUTH_RATE_LIMIT_FORGOT_PASSWORD_MAX=5
AUTH_RATE_LIMIT_RESET_PASSWORD_MAX=5

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=amparian

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Base do link enviado no e-mail de recuperacao de senha.
# Em producao precisa ser a URL real do front (localhost e recusado no boot).
APP_WEB_URL=http://localhost:3000
PASSWORD_RESET_EXPIRES_IN=1h

# console = imprime o link no terminal (dev) | smtp = envia de verdade.
MAIL_DRIVER=console

# Prod: Brevo (smtp-relay.brevo.com:587) - 300 e-mails/dia gratis.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Precisa ser um remetente verificado no provedor, senao o relay recusa o envio.
MAIL_FROM=Amparian <no-reply@amparian.local>

PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://amparian-front.vercel.app
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_REFRESH_MAX=15
AUTH_RATE_LIMIT_FORGOT_PASSWORD_MAX=5
AUTH_RATE_LIMIT_RESET_PASSWORD_MAX=5

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=amparian

JWT_ACCESS_SECRET=change-me-access-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
